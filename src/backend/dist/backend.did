  pauseServiceListing: (id: nat) -> (bool);
  pauseTransportListing: (id: nat) -> (bool);
  placeBid: (auctionId: AuctionId, bidAmount: nat) ->
   (variant {
      err: text;
      ok: AuctionBid;
    });
  placeOrder: (listingId: ListingId, sellerId: UserId, quantity: float64,
   totalPrice: float64, deliveryAddress: Location, notes: text) ->
   (OrderPublic);
  publishAnnouncement: (authorName: text, authorOrganization: text,
   announcementType: AnnouncementType, titleEn: text, titleSw: text, bodyEn:
   text, bodySw: text, region: text, startDate: Timestamp, endDate:
   opt Timestamp, contactInfo: opt text, attachmentUrl: opt text) ->
   (GovtNGOAnnouncement);
  rateUser: (userId: UserId, rating: nat, comment: opt text) -> (bool);
  registerUser: (name: text, email: text, phone: text, nationalId: opt text,
   role: UserRole, location: Location, passwordHash: text) ->
   (UserProfilePublic);
  removeAnimalListing: (listingId: ListingId) -> (bool);
  removeCropListing: (listingId: ListingId) -> (bool);
  removeGroupMember: (groupId: GroupId, userId: UserId) -> (bool);
  removeInventoryItem: (id: InventoryItemId) -> (bool);
  replyToTopic: (topicId: TopicId, body: text) ->
   (variant {
      err: text;
      ok: text;
    });
  reportOutbreak: (region: text, district: opt text, outbreakType:
   OutbreakType, diseaseName: text, severity: OutbreakSeverity, description:
   text, affectedArea: opt text, coordinates:
   opt record {
         lat: float64;
         lng: float64;
       }) -> (OutbreakRecord);
  requestBooking: (providerId: UserId, serviceId: nat, scheduledAt:
   Timestamp, location: Location, totalPrice: float64, notes: text) ->
   (BookingPublic);
  requestOtp: (identifier: text) -> (text);
  respondToBulkBuy: (requestId: BulkBuyId, quantity: float64, note: text) ->
   (bool);
  respondToJobApplication: (applicationId: JobApplicationId, accept: 
   bool) -> (bool);
  resumeAnimalListing: (listingId: ListingId) -> (bool);
  resumeCropListing: (listingId: ListingId) -> (bool);
  resumeInputProduct: (id: nat) -> (bool);
  resumeListing: (id: ListingId) -> (bool);
  resumeServiceListing: (id: nat) -> (bool);
  resumeTransportListing: (id: nat) -> (bool);
  reviewAnimalDiagnosis: (diagnosisId: DiagnosisId, newStatus:
   variant {
     confirmed;
     rejected;
   }, notes: opt text) -> (opt DiagnosisResultPublic);
  reviewCropDiagnosis: (diagnosisId: DiagnosisId, newStatus:
   variant {
     confirmed;
     rejected;
   }, notes: opt text) -> (opt DiagnosisResultPublic);
  saveFarmBoundary: (name: text, boundaryType: BoundaryType, coordinates:
   vec Coordinate, areaHectares: opt float64, areaLabel: opt text, color:
   opt text) -> (FarmBoundary);
  sendMessage: (conversationId: ConversationId, content: text, imageUrl:
   opt text) -> (MessagePublic);
  sendOutbreakAlert: (outbreakId: OutbreakId, recipientId: UserId, message:
   text) -> (OutbreakAlert);
  setIrrigationReminder: (id: IrrigationId) -> (bool);
  setTransportTimeSlots: (slots: vec text, availabilityStatus:
   TransportAvailabilityStatus) -> ();
  setupFarmerProfile: (farmSize: float64, cropTypes: vec text, soilType:
   opt text) -> (bool);
  setupLivestockProfile: (animalTypes: vec text, totalHeadCount: nat) ->
   (bool);
  signDigitalContract: (id: ContractId) -> (bool);
  startConversation: (recipientId: UserId, subject: opt text, firstMessage:
   text) -> (ConversationPublic);
  submitAnimalDiagnosis: (description: text, imageData: opt text, symptoms:
   vec text, animalType: opt text, animalId: opt nat) ->
   (DiagnosisResultPublic);
  submitCropDiagnosis: (description: text, imageData: opt text, symptoms:
   vec text, cropType: opt text, location: opt Location) ->
   (DiagnosisResultPublic);
  submitImageAnalysis: (farmId: opt nat, imageUrl: text, imageType:
   ImageType, analysisType: AnalysisType) -> (DroneAnalysis);
  submitInsuranceApplication: (coverageType: CoverageType, description: 
   text, estimatedValue: nat, supportingNotes: text) -> (InsuranceAppId);
  submitJobRating: (jobId: JobId, ratee: principal, stars: nat, comment:
   text) -> (bool);
  submitSoilAnalysis: (description: text, imageData: opt text) ->
   (DiagnosisResultPublic);
  updateAnimalHealth: (animalId: nat, healthStatus:
   variant {
     deceased;
     healthy;
     sick;
     under_treatment;
   }, notes: text) -> (bool);
  updateAnimalListing: (listingId: ListingId, count: opt nat, pricePerHead:
   opt float64, description: opt text, imageUrl: opt text) ->
   (opt AnimalListingPublic);
  updateBookingStatus: (bookingId: nat, newStatus:
   variant {
     cancelled;
     completed;
     confirmed;
     in_progress;
     pending;
   }) -> (bool);
  updateCalendarEvent: (id: CalendarEventId, eventType:
   opt CalendarEventType, title: opt text, date: opt text, time: opt text,
   notes: opt text, recurring: opt RecurringPattern, recurringEndDate:
   opt text, completed: opt bool) -> (bool);
  updateContractStatus: (id: ContractId, status: ContractStatus) -> (bool);
  updateCropListing: (listingId: ListingId, quantityKg: opt float64,
   pricePerKg: opt float64, description: opt text, imageUrl: opt text) ->
   (opt CropListingPublic);
  updateDigitalRecord: (id: RecordId, title: text, description: text, amount:
   opt float64) -> (bool);
  updateFarmBoundary: (id: FarmBoundaryId, name: text, coordinates:
   vec Coordinate, areaHectares: opt float64, areaLabel: opt text, color:
   opt text) -> (bool);
  updateInputProduct: (id: nat, name: opt text, description: opt text,
   pricePerUnit: opt float64, stockQuantity: opt float64, imageUrl:
   opt text) -> (opt InputProductPublic);
  updateInsuranceApplicationStatus: (appId: InsuranceAppId, status:
   AppStatus) -> (bool);
  updateInsuranceClaimStatus: (claimId: ClaimId, status: ClaimStatus) ->
   (bool);
  updateInventoryItem: (id: InventoryItemId, quantity: float64, changeType:
   InventoryChangeType, note: text) -> (bool);
  updateJobStatus: (jobId: JobId, status: JobStatus) -> (bool);
  updateListing: (id: ListingId, title: opt text, description: opt text,
   price: opt float64, quantity: opt float64, imageUrls: opt vec text) ->
   (opt ListingPublic);
  updateLoanStatus: (id: LoanId, status: LoanStatus, notes: opt text) ->
   (bool);
  updateMarketPrice: (priceId: nat, newPrice: float64) -> (bool);
  updateMyProfile: (name: opt text, location: opt Location, language:
   opt Language, profilePictureData: opt text) -> (bool);
  updateOrderStatus: (orderId: OrderId, newStatus: OrderStatus) -> (bool);
  updateServiceListing: (id: nat, description: opt text, priceMin:
   opt float64, priceMax: opt float64, coverageAreas: opt vec text,
   equipment: opt vec text) -> (opt ServiceListingPublic);
  upvoteReply: (replyId: nat) -> (bool);
  verifyOtp: (identifier: text, otp: text) -> (bool);
}
