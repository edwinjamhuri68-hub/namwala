   createdAt: Timestamp;
   id: ConversationId;
   lastMessageAt: Timestamp;
   lastMessagePreview: text;
   participants: vec UserId;
   subject: opt text;
 };
type ConversationId = nat;
type ContractTemplateType = 
 variant {
   crop_sale;
   delivery_agreement;
   service_agreement;
 };
type ContractStatus = 
 variant {
   active;
   completed;
   disputed;
   draft;
   pending_acceptance;
 };
type ContractId = nat;
type ContentType = 
 variant {
   article;
   guide;
   tip;
 };
type ContentCategory = 
 variant {
   energy;
   grazing;
   pesticide;
   soil;
   water;
 };
type ClaimType = 
 variant {
   drought;
   flood;
   other;
   pestDisease;
   theft;
 };
type ClaimStatus = 
 variant {
   approved;
   filed;
   paid;
   rejected;
   underReview;
 };
type ClaimId = nat;
type CertificationLevel = 
 variant {
   carbonChampion;
   soilSteward;
   waterGuardian;
 };
type CategoryId = nat;
type CarbonPracticeId = nat;
type CarbonPractice = 
 record {
   carbonImpactKg: nat;
   dateLogged: int;
   description: text;
   id: CarbonPracticeId;
   owner: principal;
   pointsAwarded: nat;
   practiceType: PracticeType__1;
 };
type CarbonCertification = 
 record {
   awardedAt: int;
   id: CarbonCertId;
   level: CertificationLevel;
   owner: principal;
   totalPoints: nat;
 };
type CarbonCertId = nat;
type CalendarEventType = 
 variant {
   breeding;
   deworming;
   feeding;
   fertilizer;
   harvest;
   healthCheck;
   irrigation;
   livestockSale;
   marketDay;
   pestControl;
   planting;
   soilTesting;
   vaccination;
   vetAppointment;
 };
type CalendarEventId = nat;
type CalendarEvent = 
 record {
   completed: bool;
   createdAt: Timestamp;
   date: text;
   eventType: CalendarEventType;
   id: CalendarEventId;
   notes: opt text;
   recurring: RecurringPattern;
   recurringEndDate: opt text;
   time: opt text;
   title: text;
   userId: UserId;
 };
type BulkBuyStatus = 
 variant {
   cancelled;
   fulfilled;
   open;
 };
type BulkBuyResponse = 
 record {
   note: text;
   quantity: float64;
   respondedAt: Timestamp;
   responderId: UserId;
 };
type BulkBuyRequest = 
 record {
   createdAt: Timestamp;
   groupId: GroupId;
   id: BulkBuyId;
   itemName: text;
   quantity: float64;
   requesterId: UserId;
   responses: vec BulkBuyResponse;
   status: BulkBuyStatus;
   targetDate: Timestamp;
   unit: text;
 };
type BulkBuyId = nat;
type BoundaryType = 
 variant {
   farm_field;
   grazing_zone;
   orchard;
   other;
 };
type BookingPublic = 
 record {
   clientId: UserId;
   createdAt: Timestamp;
   id: nat;
   location: Location;
   notes: text;
   providerId: UserId;
   scheduledAt: Timestamp;
   serviceId: nat;
   status: variant {
             cancelled;
             completed;
             confirmed;
             in_progress;
             pending;
           };
   totalPrice: float64;
 };
type BidId = nat;
type BITrend = 
 variant {
   down;
   flat;
   up;
 };
type BIReportType = 
 variant {
   crop_profitability;
   livestock_profitability;
   market_opportunity;
   profit_forecast;
 };
type BIReportId = nat;
type BIReport = 
 record {
   generatedAt: Timestamp;
   id: BIReportId;
   insights: vec BIInsight;
   period: BIPeriod;
   reportType: BIReportType;
   userId: UserId;
 };
type BIPeriod = 
 variant {
   monthly;
   quarterly;
   weekly;
 };
type BIInsight = 
 record {
   descriptionEn: text;
   descriptionSw: text;
   recommendationEn: text;
   recommendationSw: text;
   titleEn: text;
   titleSw: text;
   trend: BITrend;
   unit: text;
   value: float64;
 };
type AuctionStatus = 
 variant {
   active;
   cancelled;
   completed;
   ended;
 };
type AuctionResult = 
 record {
   auctionId: AuctionId;
   completedAt: opt Timestamp;
   finalPrice: nat;
   sellerAccepted: opt bool;
   winnerId: opt UserId;
 };
type AuctionListingType = 
 variant {
   crop;
   livestock;
 };
type AuctionListing = 
 record {
   bidCount: nat;
   currentBid: nat;
   currentBidderId: opt UserId;
   description: text;
   endTime: Timestamp;
   id: AuctionId;
   images: vec text;
   isAnonymousBidding: bool;
   listingType: AuctionListingType;
   quantity: nat;
   region: text;
   sellerId: UserId;
   startTime: Timestamp;
   startingPrice: nat;
   status: AuctionStatus;
   title: text;
   unit: text;
 };
type AuctionId = nat;
type AuctionBid = 
 record {
   auctionId: AuctionId;
   bidAmount: nat;
   bidderId: UserId;
   id: BidId;
   isWinning: bool;
   placedAt: Timestamp;
 };
type ApplicationStatus = 
 variant {
   accepted;
   declined;
   pending;
 };
type AppStatus = 
 variant {
   approved;
   pending;
   rejected;
 };
type AnnouncementType = 
 variant {
   emergency;
   opportunity;
   policy_update;
   subsidy;
   training;
 };
type AnnouncementId = nat;
type AnimalRecordPublic = 
 record {
   animalType: text;
   breed: opt text;
   count: nat;
   createdAt: Timestamp;
   healthStatus: variant {
                   deceased;
                   healthy;
                   sick;
                   under_treatment;
                 };
   id: nat;
   keeperId: UserId;
   notes: text;
 };
type AnimalListingPublic = 
 record {
   animalType: text;
   breed: opt text;
   count: nat;
   createdAt: Timestamp;
   description: text;
   id: ListingId;
   imageUrl: opt text;
   inquiryCount: nat;
   isAvailable: bool;
   keeperId: UserId;
   location: Location;
   pricePerHead: float64;
   updatedAt: Timestamp;
 };
type AnimalAnalytics = 
 record {
   animalType: text;
   count: nat;
   revenue: float64;
 };
type AnalyticsPeriod = 
 variant {
   month;
   quarter;
   year;
 };
type AnalysisType = 
 variant {
   crop_health;
   disease_spread;
   grazing_conditions;
   irrigation_coverage;
 };
type AnalysisStatus = 
 variant {
   complete;
   failed;
   pending;
 };
type AnalysisId = nat;
type AlertId = nat;
type AiInsight = 
 record {
   category: text;
   finding: text;
   recommendation: text;
   severity: InsightSeverity;
 };
service : {
  acceptDigitalContract: (id: ContractId) -> (bool);
  addAnimal: (animalType: text, breed: opt text, count: nat) ->
   (AnimalRecordPublic);
  addAnimalListing: (animalType: text, breed: opt text, count: nat,
   pricePerHead: float64, description: text, imageUrl: opt text, location:
   Location) -> (AnimalListingPublic);
  addCropListing: (cropType: text, quantityKg: float64, pricePerKg: float64,
   description: text, imageUrl: opt text, location: Location) ->
   (CropListingPublic);
  addDigitalRecord: (recordType: RecordType, date: Timestamp, title: 
   text, description: text, amount: opt float64, unit: opt text, category:
   opt text, linkedId: opt nat) -> (DigitalRecord);
  addImprovementSuggestion: (suggestionText: text, category: text) ->
   (InsightSuggestionId);
  addInputProduct: (name: text, category:
   variant {
     equipment;
     feed;
     fertilizer;
     other;
     pesticide;
     seeds;
   }, description: text, pricePerUnit: float64, unit: text, stockQuantity:
   float64, imageUrl: opt text) -> (InputProductPublic);
  addInventoryItem: (name: text, category: InventoryCategory, quantity:
   float64, unit: text, reorderLevel: float64, supplierContact: opt text) ->
   (InventoryItem);
  addMarketPrice: (commodity: text, commodityType:
   variant {
     animal;
     crop;
     input;
   }, pricePerUnit: float64, unit: text, market: text, region: text) ->
   (MarketPricePublic);
  addMarketRecommendation: (commodity: text, recommendation: text, action:
   variant {
     buy;
     hold;
     sell;
     wait;
   }, targetPrice: opt float64, targetDate: opt Timestamp, reasoning:
   text) -> (MarketRecommendation);
  addServiceListing: (serviceType: text, description: text, priceMin:
   float64, priceMax: float64, coverageAreas: vec text, equipment:
   vec text) -> (ServiceListingPublic);
  addSoilReport: (farmId: nat, phLevel: float64, nitrogen: float64,
   phosphorus: float64, potassium: float64, texture: text, suitableCrops:
   vec text) -> (SoilReport);
  addSpecialistDiagnosisAttachment: (diagnosisId: text, photoUrls: vec text,
   notes: text) -> (SpecialistDiagnosisAttachment);
  addSpecialistNote: (id: TraceabilityId, note: text, photoUrls: vec text) ->
   (bool);
  addSpecialistProductNote: (id: TraceabilityId, note: text, photoUrls:
   vec text) -> (bool);
  addSustainabilityContent: (contentType: ContentType, title: text, bodyEn:
   text, bodySw: text, category: ContentCategory) -> (SustainabilityContent);
  addTraceabilityEvent: (id: TraceabilityId, eventType: text, description:
   text) -> (bool);
  addTransportListing: (vehicleType: text, capacityTons: float64, pricePerKm:
   float64, coverageAreas: vec text) -> (TransportListingPublic);
  addTreatmentRecord: (animalId: nat, diagnosis: text, treatment: text,
   medication: vec text, notes: text) -> (TreatmentRecordPublic);
  addVaccinationRecord: (animalId: nat, keeperId: UserId, vaccineName: 
   text, nextDueAt: opt Timestamp, notes: text) -> (VaccinationRecord);
  applyForLoan: (amount: float64, purpose: text, durationMonths: nat,
   repaymentTerms: text) -> (LoanApplication);
  applyToJob: (jobId: JobId, coverNote: text) -> (JobApplicationId);
  cancelAuction: (auctionId: AuctionId) -> (bool);
  changePassword: (oldPasswordHash: text, newPasswordHash: text) -> (bool);
  closeAuction: (auctionId: AuctionId) ->
   (variant {
      err: text;
      ok: AuctionResult;
    });
  confirmDelivery: (paymentId: PaymentId) -> (bool);
  confirmPayment: (paymentId: PaymentId) -> (bool);
  createAuction: (listingType: AuctionListingType, title: text, description:
   text, startingPrice: nat, endTime: Timestamp, quantity: nat, unit: 
   text, images: vec text, region: text, isAnonymousBidding: bool) ->
   (AuctionListing);
  createBulkBuyRequest: (groupId: GroupId, itemName: text, quantity: 
   float64, unit: text, targetDate: Timestamp) -> (BulkBuyRequest);
  createCalendarEvent: (eventType: CalendarEventType, title: text, date:
   text, time: opt text, notes: opt text, recurring: RecurringPattern,
   recurringEndDate: opt text) -> (CalendarEvent);
  createDigitalContract: (counterpartyId: UserId, templateType:
   ContractTemplateType, title: text, partiesNames: text, terms: text,
   amount: float64, currency: text, startDate: Timestamp, endDate:
   Timestamp) -> (DigitalContract);
  createFarm: (name: text, location: Location, sizeHectares: float64,
   cropTypes: vec text) -> (FarmRecord);
  createFarmingGroup: (name: text, description: text) -> (FarmingGroup);
  createGroupListing: (groupId: GroupId, listingIds: vec ListingId, title:
   text, description: text) -> (GroupListing);
  createJobListing: (title: text, description: text, jobType: JobType,
   payRate: text, location: text, deadline: int, requiredSkills: vec text) ->
   (JobId);
  createListing: (listingType: ListingType, title: text, description: 
   text, price: float64, quantity: opt float64, unit: opt text, location:
   Location, imageUrls: vec text, tags: vec text) -> (ListingPublic);
  createProductTraceability: (listingId: ListingId, farmName: text, location:
   Location) -> (ProductTraceability);
  createTopic: (categoryId: CategoryId, title: text, body: text, tags:
   vec text, language: Language) -> (variant {
                                       err: text;
                                       ok: text;
                                     });
  createTransportBooking: (providerId: UserId, distanceKm: float64,
   ratePerKm: float64, selectedTimeSlot: text, pickupAddress: text,
   deliveryAddress: text) -> (TransportBooking);
  createWorkerProfile: (name: text, skills: vec text, serviceArea: text,
   availability: text, bio: text) -> (WorkerProfileId);
  deactivateAnnouncement: (id: AnnouncementId) -> (bool);
  deactivateListing: (id: ListingId) -> (bool);
  deactivateOutbreak: (id: OutbreakId) -> (bool);
  deleteCalendarEvent: (id: CalendarEventId) -> (bool);
  deleteDigitalRecord: (id: RecordId) -> (bool);
  deleteFarmBoundary: (id: FarmBoundaryId) -> (bool);
  deleteForecast: (id: ForecastId) -> (bool);
  deleteInputProduct: (id: nat) -> (bool);
  deleteServiceListing: (id: nat) -> (bool);
  deleteSustainabilityPractice: (id: SustainabilityRecordId) -> (bool);
  fileInsuranceClaim: (applicationId: InsuranceAppId, claimType: ClaimType,
   damageDescription: text, estimatedLoss: nat, evidenceNotes: text) ->
   (ClaimId);
  generateBIReport: (reportType: BIReportType, period: BIPeriod) ->
   (BIReport);
  generateFarmAnalytics: (period: AnalyticsPeriod) -> (FarmAnalyticsSnapshot);
  generateForecast: (forecastType: ForecastType, title: text,
   cropOrAnimalType: text, region: text) -> (ForecastRecord);
  generateIrrigationRecommendation: (cropType: text, region: text) ->
   (IrrigationRecommendation);
  getAnalysesByFarm: (farmId: nat) -> (vec DroneAnalysis) query;
  getAnalysisById: (id: AnalysisId) -> (opt DroneAnalysis) query;
  getAnimalDiagnosisById: (diagnosisId: DiagnosisId) ->
   (opt record {
          DiagnosisRequest;
          opt DiagnosisResultPublic;
        }) query;
  getAnimalListings: (keeperId: opt UserId) ->
   (vec AnimalListingPublic) query;
  getAnnouncement: (id: AnnouncementId) -> (opt GovtNGOAnnouncement) query;
  getAuction: (id: AuctionId) -> (opt AuctionListing) query;
  getAuctionResult: (auctionId: AuctionId) -> (opt AuctionResult) query;
  getAuctions: (status: opt AuctionStatus, listingType:
