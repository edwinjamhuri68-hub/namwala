  getBIReport: (id: BIReportId) -> (opt BIReport) query;
  getBidsForAuction: (auctionId: AuctionId) -> (vec AuctionBid) query;
  getCalendarEvents: () -> (vec CalendarEvent) query;
  getCategories: () -> (vec ForumCategoryPublic) query;
  getCropListings: (farmerId: opt UserId) -> (vec CropListingPublic) query;
  getDiagnosisById: (diagnosisId: DiagnosisId) ->
